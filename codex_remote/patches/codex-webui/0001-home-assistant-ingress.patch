diff --git a/src/ha-ingress.ts b/src/ha-ingress.ts
new file mode 100644
index 0000000..a4d28e7
--- /dev/null
+++ b/src/ha-ingress.ts
@@ -0,0 +1,15 @@
+import type { FastifyRequest } from 'fastify';
+import type { Socket } from 'socket.io';
+const HA_INGRESS_PROXY = '172.30.32.2';
+export function isTrustedHaPeer(address: unknown): boolean { return address === HA_INGRESS_PROXY || address === `::ffff:${HA_INGRESS_PROXY}`; }
+export function normalizeIngressPath(header: string | string[] | undefined): string | null {
+  const raw = Array.isArray(header) ? header[0] : header;
+  const candidate = raw?.split(',', 1)[0]?.trim();
+  if (!candidate || candidate === '/') return '/';
+  if (!candidate.startsWith('/') || /["'<>?#\\\u0000-\u001f\u007f]/.test(candidate)) return null;
+  const segments = candidate.split('/').filter(Boolean);
+  return segments.length ? `/${segments.join('/')}/` : '/';
+}
+export function ingressPathFromHeaders(headers: Record<string, string | string[] | undefined>): string | null { return normalizeIngressPath(headers['x-ingress-path'] ?? headers['x-forwarded-prefix']); }
+export function isTrustedHaHttpRequest(request: FastifyRequest): boolean { return isTrustedHaPeer(request.ip ?? request.socket.remoteAddress) && ingressPathFromHeaders(request.headers) !== null; }
+export function isTrustedHaSocket(socket: Socket): boolean { return isTrustedHaPeer(socket.handshake.address ?? socket.conn.remoteAddress) && ingressPathFromHeaders(socket.handshake.headers) !== null; }
diff --git a/src/ha-ingress.spec.ts b/src/ha-ingress.spec.ts
new file mode 100644
index 0000000..1023d85
--- /dev/null
+++ b/src/ha-ingress.spec.ts
@@ -0,0 +1,22 @@
+import { describe, expect, it } from 'vitest';
+import { ingressPathFromHeaders, isTrustedHaHttpRequest, isTrustedHaPeer, isTrustedHaSocket, normalizeIngressPath } from './ha-ingress';
+describe('Home Assistant ingress helpers', () => {
+  it('validates peers and paths', () => {
+    expect(isTrustedHaPeer('172.30.32.2')).toBe(true);
+    expect(isTrustedHaPeer('127.0.0.1')).toBe(false);
+    expect(normalizeIngressPath('/api/hassio_ingress/codex_remote')).toBe('/api/hassio_ingress/codex_remote/');
+    expect(normalizeIngressPath('/bad?token=secret')).toBeNull();
+  });
+  it('prefers X-Ingress-Path and supports fallback', () => {
+    expect(ingressPathFromHeaders({ 'x-ingress-path': '/current', 'x-forwarded-prefix': '/wrong' })).toBe('/current/');
+    expect(ingressPathFromHeaders({ 'x-forwarded-prefix': '/legacy' })).toBe('/legacy/');
+  });
+  it('requires the Supervisor peer for HTTP and Socket.IO', () => {
+    const headers = { 'x-ingress-path': '/api/hassio_ingress/codex_remote' };
+    expect(isTrustedHaHttpRequest({ ip: '172.30.32.2', headers } as any)).toBe(true);
+    expect(isTrustedHaHttpRequest({ ip: '10.0.0.8', headers } as any)).toBe(false);
+    expect(isTrustedHaHttpRequest({ ip: '172.30.32.2', headers: { 'x-ingress-path': '/bad?spoof' } } as any)).toBe(false);
+    expect(isTrustedHaSocket({ handshake: { address: '::ffff:172.30.32.2', headers } } as any)).toBe(true);
+    expect(isTrustedHaSocket({ handshake: { address: '10.0.0.8', headers } } as any)).toBe(false);
+  });
+});
