{
  "name": "hass-codex-web",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "dev:mock": "npm run build && mkdir -p .mock-config .mock-data && HASS_CODEX_MOCK=true HASS_CODEX_CLIENT_ROOT=$PWD/dist/client HASS_CODEX_WORKSPACE=$PWD/.mock-config CODEX_HOME=$PWD/.mock-data node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.8.0",
    "@agentclientprotocol/sdk": "1.4.0",
    "@assistant-ui/react": "0.15.17",
    "@fastify/static": "8.3.0",
    "@fastify/websocket": "11.3.0",
    "fastify": "5.12.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "22.18.3",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.35.0",
    "@eslint/js": "9.35.0",
    "globals": "16.4.0",
    "typescript-eslint": "8.42.0",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vitest": "3.2.4"
  }
}
